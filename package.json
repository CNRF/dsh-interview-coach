{
  "name": "dsh-interview-coach",
  "description": "Voice interview coach for DeepSeek Harness: configure your tech stack, level and target JD, answer spoken interview questions, get per-answer 100-point scoring and a full interview report. · 语音面试助手：选技术栈与参考资料，语音问答，逐题百分制打分，生成面试记录文档。",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CNRF/dsh-interview-coach.git"
  },
  "homepage": "https://github.com/CNRF/dsh-interview-coach#readme",
  "bugs": {
    "url": "https://github.com/CNRF/dsh-interview-coach/issues"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "interview",
    "voice",
    "coach"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
